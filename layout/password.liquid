<!DOCTYPE html>
{%- comment -%} SHOPIFY PAGE MAPPING: layout/password.liquid -> wrapper for the PASSWORD page {%- endcomment -%}
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..600&family=Inter:wght@400;600&display=swap" rel="stylesheet">
  <style>
    :root{--bg:#F4ECDF;--brown:#20140C;--gold:#C2863F;--cta:#3A2414;--ctatext:#F3E9DB;--line:rgba(32,20,12,.14);--serif:'Fraunces',serif;--sans:'Inter',sans-serif}
    *{box-sizing:border-box;margin:0;padding:0}
    body{font-family:var(--sans);background:var(--bg);color:var(--brown)}
    .h2{font-family:var(--serif);font-weight:400;font-size:1.8rem}
    .btn{display:inline-flex;align-items:center;justify-content:center;font-weight:600;padding:12px 22px;border-radius:999px;border:none;cursor:pointer}
    .btn-primary{background:var(--cta);color:var(--ctatext)}
  </style>
</head>
<body>{{ content_for_layout }}</body>
</html>
