{%- comment -%} SHOPIFY PAGE MAPPING: templates/cart.liquid -> CART PAGE {%- endcomment -%}
<section style="max-width:900px;margin:0 auto;padding:60px 20px">
  <h1 class="h2" style="margin-bottom:24px">Your Cart</h1>
  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post">
      {% for item in cart.items %}
        <div style="display:flex;gap:16px;align-items:center;padding:16px 0;border-bottom:1px solid var(--line)">
          {% if item.image %}<img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title | escape }}" width="70" height="70" style="border-radius:10px">{% endif %}
          <div style="flex:1"><a href="{{ item.url }}" style="font-weight:600">{{ item.product.title }}</a><br><span class="count">{{ item.variant.title }}</span></div>
          <div>{{ item.quantity }} × {{ item.final_price | money }}</div>
          <a href="{{ item.url_to_remove }}" style="color:#c0392b;font-size:.85rem">Remove</a>
        </div>
      {% endfor %}
      <div style="display:flex;justify-content:space-between;align-items:center;margin-top:24px">
        <strong style="font-size:1.2rem">Subtotal: {{ cart.total_price | money }}</strong>
        <button type="submit" name="checkout" class="btn btn-primary btn-lg">Checkout →</button>
      </div>
    </form>
  {% else %}
    <p>Your cart is empty.</p>
    <a href="/products/{{ settings.product_handle | default: 'face-ritual-tallow-balm' }}" class="btn btn-primary btn-lg" style="margin-top:16px">Shop The Face Balm →</a>
  {% endif %}
</section>
