{%- comment -%} SHOPIFY PAGE MAPPING: templates/password.liquid -> PASSWORD PAGE (inside layout/password.liquid) {%- endcomment -%}
<div style="max-width:440px;margin:0 auto;padding:90px 20px;text-align:center">
  <div style="font-family:var(--serif);font-size:1.6rem;letter-spacing:.14em;margin-bottom:12px">{{ shop.name | upcase }}</div>
  <h1 class="h2" style="margin-bottom:10px">Something Good Is Brewing.</h1>
  <p style="opacity:.75;margin-bottom:24px">One jar. Four ingredients. Enter the password to take a look.</p>
  {% form 'storefront_password' %}
    {% if form.errors %}<p style="color:#c0392b;margin-bottom:12px">Wrong password — try again.</p>{% endif %}
    <div style="display:flex;gap:10px;max-width:360px;margin:0 auto">
      <input type="password" name="password" placeholder="Password" required style="flex:1;padding:12px;border:1px solid var(--line);border-radius:10px">
      <button type="submit" class="btn btn-primary">Enter →</button>
    </div>
  {% endform %}
</div>
