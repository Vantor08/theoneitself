{%- comment -%} SHOPIFY PAGE MAPPING: templates/collection.liquid -> COLLECTION PAGE {%- endcomment -%}
<section style="max-width:1200px;margin:0 auto;padding:60px 20px">
  <h1 class="h2" style="margin-bottom:8px">{{ collection.title | default: 'Shop' }}</h1>
  <div class="rte" style="opacity:.75;margin-bottom:28px">{{ collection.description }}</div>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:22px">
    {% for product in collection.products %}
      <a href="{{ product.url }}" style="display:block">
        <div style="background:var(--bg3);border-radius:14px;aspect-ratio:1/1;overflow:hidden;margin-bottom:10px">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.title | escape }}" width="250" height="250">{% endif %}</div>
        <h3 style="font-size:1.05rem">{{ product.title }}</h3>
        <div class="price" style="font-size:1.1rem">{{ product.price | money }}{% if product.compare_at_price > product.price %} <span class="price-compare" style="font-size:.9rem">{{ product.compare_at_price | money }}</span>{% endif %}</div>
      </a>
    {% else %}
      <p>No products in this collection yet.</p>
    {% endfor %}
  </div>
</section>
