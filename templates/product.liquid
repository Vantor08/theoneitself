{%- comment -%}
  SHOPIFY PAGE MAPPING: templates/product.liquid -> PRODUCT PAGE
  Matches the base44 TallowCraft product page. Buy box posts to Shopify /cart/add; the
  Solo/Duo/Trio tiers map to the product's variants when present, else to the first variant.
{%- endcomment -%}
{%- assign cv = product.selected_or_first_available_variant -%}
{%- assign v1 = product.variants[0] -%}
{%- assign v2 = product.variants[1] | default: product.variants[0] -%}
{%- assign v3 = product.variants[2] | default: product.variants[0] -%}

<div class="crumb"><a href="{{ routes.root_url }}">Home</a> / {{ product.title | default: 'Vallore Tallow Balm' }}</div>

<section class="pdp" id="buy">
  <!-- GALLERY -->
  <div class="gal">
    <div class="gal__main">{%- if product.featured_image -%}<img id="galMain" src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.title }}">{%- else -%}VALLORE™{%- endif -%}</div>
    {%- if product.images.size > 1 -%}
    <div class="gal__thumbs">
      {%- for image in product.images limit: 5 -%}
        <button class="gal__t" onclick="document.getElementById('galMain').src='{{ image | image_url: width: 900 }}'"><img src="{{ image | image_url: width: 180 }}" alt=""></button>
      {%- endfor -%}
    </div>
    {%- endif -%}
  </div>

  <!-- BUY COLUMN -->
  <div class="buy">
    <span class="eyebrow">Beef Tallow · For Men</span>
    <h1>{{ product.title | default: 'Vallore Tallow Balm' }}</h1>
    <div class="rr"><span class="stars">★★★★★</span><b>4.8</b><span class="muted">· 2,140 reviews</span></div>
    <div class="buy__price"><span class="price-now" id="buyPrice">{{ cv.price | money }}</span>{% if cv.compare_at_price > cv.price %}<span class="price-was">{{ cv.compare_at_price | money }}</span>{% endif %}<span class="badge">60% OFF</span></div>

    <ul class="blist">
      <li><span class="ck">✓</span>Stop looking tired in every photo she takes</li>
      <li><span class="ck">✓</span>Shave without the burn and tight, flaky skin after</li>
      <li><span class="ck">✓</span>One jar replaces the moisturizer, aftershave and eye cream</li>
      <li><span class="ck">✓</span>A 10-second habit your son will copy one day</li>
    </ul>

    <div class="urg"><b>● Only 14 units left at this price</b><p>Selling fast — 253 orders in the last 48 hours</p></div>

    <form action="/cart/add" method="post" id="pdpForm">
      <input type="hidden" name="id" id="pdpVariantId" value="{{ cv.id }}">
      <p class="supply__lbl">Choose your supply:</p>

      <label class="tier{% unless v2.id != v1.id %} sel{% endunless %}" data-tier data-variant="{{ v1.id }}" data-price="$34.00">
        <input type="radio" name="tier" value="{{ v1.id }}">
        <div class="tier__row">
          <div><span class="tier__name">The Solo</span><div class="tier__sub">1 jar · 30-day supply</div></div>
          <div><span class="price-was" style="font-size:.9rem">$49</span> <span class="tier__pr">$34</span></div>
        </div>
      </label>

      <label class="tier sel" data-tier data-variant="{{ v2.id }}" data-price="$49.99">
        <div class="tier__top"><span class="tier__bf">Black Friday · 50% Off</span><span class="tier__pop">Most Popular</span></div>
        <input type="radio" name="tier" value="{{ v2.id }}" checked>
        <div class="tier__row">
          <div><span class="tier__name">The Duo</span><div class="tier__sub">2 jars · <span class="tier__save">Save $48</span></div><span class="tier__ship">✓ Free Shipping</span></div>
          <div><span class="price-was" style="font-size:.9rem">$98</span> <span class="tier__pr">$49.99</span></div>
        </div>
      </label>

      <label class="tier" data-tier data-variant="{{ v3.id }}" data-price="$59.99">
        <div class="tier__top"><span class="tier__bf">Black Friday · 50% Off</span></div>
        <input type="radio" name="tier" value="{{ v3.id }}">
        <div class="tier__row">
          <div><span class="tier__name">The Trio</span><div class="tier__sub">3 jars · <span class="tier__save">Save $87</span></div><span class="tier__ship">✓ Free Shipping</span></div>
          <div><span class="price-was" style="font-size:.9rem">$147</span> <span class="tier__pr">$59.99</span></div>
        </div>
      </label>

      <div class="subrow"><span>Subscribe &amp; save 15%: zero commitment, cancel anytime</span><span class="subrow__t"></span></div>
      <div class="subfreq"><span><b>1 bundle</b> · every 30 days</span><span><b>2 bundles</b> · every 60 days</span><span><b>3 bundles</b> · every 90 days</span></div>

      <button type="submit" name="add" class="btn btn-cta btn-lg btn-full atc" id="pdpAtc">🛒 Add to cart — <span id="atcPrice">{{ cv.price | money }}</span></button>
    </form>

    <div class="urgline">⏱ Early Black Friday — 40% off while it lasts</div>
    <div class="pline">● Orders processed in 24–48 hrs · Free shipping on orders over $45</div>

    <div class="tcards">
      <div class="tcard"><div class="ti">🛡</div><b>60-Day Promise</b></div>
      <div class="tcard"><div class="ti">🚚</div><b>Free Shipping Over $45</b></div>
      <div class="tcard"><div class="ti">🔒</div><b>Secure Checkout</b></div>
    </div>
    <div class="pay"><span>VISA</span><span>MASTERCARD</span><span>APPLE PAY</span><span>PAYPAL</span></div>

    <div style="margin-top:20px">
      <div class="acc__i" data-faq><button type="button" class="acc__q" data-faq-trig>How does beef tallow balm work?<span class="pm">+</span></button><div class="acc__a"><p>Grass-fed tallow is about 87% a match for the oil your own skin makes, so it absorbs instead of sitting on top. Honey and jojoba calm and balance; vitamin E protects.</p></div></div>
      <div class="acc__i" data-faq><button type="button" class="acc__q" data-faq-trig>Made for a man's skin<span class="pm">+</span></button><div class="acc__a"><p>Thicker, oilier, shaved daily. Vallore is built for exactly that — it handles razor burn and dryness without any fuss or fragrance.</p></div></div>
      <div class="acc__i" data-faq><button type="button" class="acc__q" data-faq-trig>How to use it<span class="pm">+</span></button><div class="acc__a"><p>Warm a pea-sized amount between your fingers and press into clean face and neck. Morning and night. Ten seconds, done.</p></div></div>
      <div class="acc__i" data-faq><button type="button" class="acc__q" data-faq-trig>60-day money-back promise<span class="pm">+</span></button><div class="acc__a"><p>Use the whole jar. If your skin doesn't look better in 60 days, email us for a full refund — jar empty or not.</p></div></div>
      <div class="acc__i" data-faq><button type="button" class="acc__q" data-faq-trig>Shipping time<span class="pm">+</span></button><div class="acc__a"><p>Orders are processed in 24–48 hours. Free shipping on orders over $45.</p></div></div>
    </div>

    <div class="quotebox"><div class="qav">DR</div><div><p><b>41, work outside, hands were shot.</b> Three weeks in and the cracked knuckles finally closed up. I'm not a skincare guy — but this I'll actually do.</p><div class="qm">Devon R. · ★★★★★ Verified buyer</div></div></div>
  </div>
</section>

